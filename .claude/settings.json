{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/verify-rules-integrity.sh\"",
            "statusMessage": "Checking rules integrity..."
          },
          {
            "type": "command",
            "command": "bash scripts/daily-snapshot.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_response.filePath // .tool_input.file_path // empty' 2>/dev/null); [ -z \"$f\" ] && exit 0; case \"$f\" in *.ts|*.tsx|*.json) prettier --write \"$f\" 2>/dev/null && echo \"✓ Formatted: $(basename $f)\";; *.py) black \"$f\" 2>/dev/null && echo \"✓ Formatted: $(basename $f)\";; esac || true",
            "statusMessage": "Auto-formatting..."
          }
        ]
      }
    ]
  },
  "allowedTools": [
    "Bash(bash scripts/sync-rules.sh)"
  ],
  "lastSnapshotDate": "2026-06-18",
  "snapshotRepo": "AI-rules",
  "snapshotTargetRepo": "",
  "snapshotBranch": "snapshot",
  "rulesVersion": "1.28.2"
}
