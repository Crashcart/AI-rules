{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.ai-rules/scripts/check-rules-updates.sh\" \"https://github.com/crashcart/ai-rules\" \"claude\" 2>/dev/null || true",
            "statusMessage": "Checking for rule updates..."
          }
        ]
      }
    ]
  },
  "rulesVersion": "1.26.3",
  "rulesRepo": "https://github.com/crashcart/ai-rules"
}
